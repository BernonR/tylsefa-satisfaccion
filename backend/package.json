{
  "name": "tylsefa-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Servicios de la aplicación - Tylsefa",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
    "desarrollo": "node --watch src/servidor.js",
    "crear-admin": "node scripts/crear-administrador.js",
